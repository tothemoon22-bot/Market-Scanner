# Copy to .env (gitignored). Never commit real values.
#
# Phases 0-3 are read-only and need NO credentials at all: Kalshi public market
# data is unauthenticated, and Binance/Coinbase reference data is public. Leave
# this file empty until Phase 4.

# --- Phase 4, demo environment ONLY -----------------------------------------
# Production credentials must not be loadable by this application. Phase 4 adds
# a startup assertion that refuses to run against a production host.
KALSHI_ENV=demo
KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi-demo.pem

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/scanner.db

# --- Kill switch ------------------------------------------------------------
# Presence of a file at this path halts trading within one loop tick.
KILL_SWITCH_PATH=./KILL
